/* Sinh tự động bởi ~/.config/theme/theme.sh — KHÔNG sửa tay. rofi @import file này. */
* {
    bg:           #{{base}}e6;     /* nền 90% đục */
    bg-alt:       #{{surface0}}b3; /* ô nhập, nút: 70% đục */
    fg:           #{{text}};
    fg-alt:       #{{subtext0}};
    accent:       #{{accent3}};    /* khung + tab điều hướng */
    accent-alt:   #{{accent}};     /* mục đang chọn */
    urgent:       #{{red}};
}
